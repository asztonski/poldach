# Values for every production build (`npm run build`), committed on purpose: they are public anyway –
# they end up in the pages. Secrets never go here; local overrides go to .env.local.

# Google Analytics 4 – property "poldach.eu", stream "Poldach" (docs/decyzje.md D-94, D-95).
# Loaded only after the visitor's consent in the cookie banner.
NEXT_PUBLIC_GA_ID=G-CNMMV1DMZR

# Web3Forms – form "poldach.eu – formularz kontaktowy" on the account poldachpk@wp.pl, which gets the
# messages (docs/decyzje.md D-85, D-98). A public key by design: it only lets a message be sent to
# that inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=179aff5d-8be0-4063-a933-4df46e1d5809
